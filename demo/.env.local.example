# Copy to .env.local and fill in. .env.local is gitignored.

# Reactor API key (https://reactor.inc). Server-side only.
REACTOR_API_KEY=rk_...

# Reactor model slug to connect to.
REACTOR_MODEL=reactor/lingbot-world-2

# OpenAI-compatible endpoint of the vLLM server deployed on Modal
# (`modal deploy modal_vllm.py` prints this URL; append /v1).
VLLM_BASE_URL=https://your-workspace--neuro-vllm-serve.modal.run/v1

# Must match VLLM_API_KEY in modal_vllm.py (Modal secret `neuro-vllm`).
VLLM_API_KEY=local-dev-key

# Model name the vLLM server serves.
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Reference image anchoring the world (JPEG/PNG path, relative to demo/).
SEED_IMAGE=assets/seed.jpg
